<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BuddiesActivity">

    <TextView
        android:id="@+id/buddiesHeader"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="2dp"
        android:background="@android:color/holo_orange_dark"
        android:padding="15dp"
        android:text="Buddies"
        android:textColor="@android:color/white"
        android:textSize="70px" />

    <TextView
        android:id="@+id/nameLabel"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/buddiesHeader"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:text="Name"
        android:textColor="@android:color/darker_gray"
        android:textSize="70px" />

    <EditText
        android:id="@+id/buddyName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/nameLabel"
        android:hint="Jane Doe"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="60px" />

    <TextView
        android:id="@+id/phoneLabel"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/buddyName"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:text="Phone Number"
        android:textColor="@android:color/darker_gray"
        android:textSize="70px" />

    <EditText
        android:id="@+id/buddyPhone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/phoneLabel"
        android:hint="5556"
        android:inputType="phone"
        android:padding="12dp"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="60px" />

    <Button
        android:id="@+id/addBuddyButton"
        android:layout_width="100pt"
        android:layout_height="wrap_content"
        android:layout_below="@id/buddyPhone"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:backgroundTint="@android:color/holo_orange_dark"
        android:text="Add Buddy" />

    <TextView
        android:id="@+id/buddyHint"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/addBuddyButton"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:text="Long-press a buddy to remove"
        android:textColor="@android:color/darker_gray"
        android:textSize="10pt" />

    <ListView
        android:id="@+id/buddyList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/buddyHint" />

</RelativeLayout>