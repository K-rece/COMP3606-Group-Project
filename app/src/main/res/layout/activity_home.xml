<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <TextView
        android:id="@+id/titleHeader"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="2dp"
        android:background="@android:color/holo_orange_dark"
        android:padding="15dp"
        android:text="Assignment Buddy"
        android:textColor="@android:color/white"
        android:textSize="70px" />

    <TextView
        android:id="@+id/welcomeUserText"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleHeader"
        android:padding="12dp"
        android:text="Welcome Username"
        android:textColor="@android:color/darker_gray"
        android:textSize="70px" />

    <TextView
        android:id="@+id/assignmentsHeader"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/welcomeUserText"
        android:layout_marginTop="20dp"
        android:background="@android:color/holo_orange_dark"
        android:padding="15dp"
        android:text="Assignments"
        android:textColor="@android:color/white"
        android:textSize="70px" />

    <Button
        android:id="@+id/addAssignment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/assignmentsHeader"
        android:layout_alignBottom="@id/assignmentsHeader"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="@android:color/holo_orange_light"
        android:text="+ Add" />

    <Spinner
        android:id="@+id/assignmentSpinner"
        android:layout_width="match_parent"
        android:layout_height="22pt"
        android:layout_below="@id/assignmentsHeader"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/countdownView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/assignmentSpinner"
        android:layout_marginStart="5dp"
        android:layout_marginTop="8dp"
        android:text="No assignment selected"
        android:textSize="10pt" />

    <TextView
        android:id="@+id/statusView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/countdownView"
        android:layout_marginStart="5dp"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="10pt" />

    <LinearLayout
        android:id="@+id/buttonRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/statusView"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/startButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/holo_orange_dark"
            android:text="Start" />

        <Button
            android:id="@+id/tickButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/holo_orange_dark"
            android:text="Question Done" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonRow1"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/finishButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/holo_orange_dark"
            android:text="Finish" />

        <Button
            android:id="@+id/buddiesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/holo_orange_light"
            android:text="Buddies" />
    </LinearLayout>

</RelativeLayout>